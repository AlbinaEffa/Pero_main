# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (with pgvector extension for semantic search)
DATABASE_URL=postgresql://user:password@localhost:5432/pero

# ─── Auth ────────────────────────────────────────────────────────────────────
# Must be set — server refuses to start without it.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# ─── AI ──────────────────────────────────────────────────────────────────────
# Провайдер: gemini (default) | openai | anthropic
# openai = любой OpenAI-совместимый API: OpenAI, OpenRouter, DeepSeek, LM Studio, Ollama…
AI_PROVIDER=gemini

# Модель чата. Defaults: gemini-2.5-flash / gpt-4o-mini / claude-sonnet-4-5
# AI_MODEL=gemini-2.5-flash

# Универсальный ключ (приоритетнее провайдер-специфичных ниже)
# AI_API_KEY=...

# Base URL для OpenAI-совместимых API (только AI_PROVIDER=openai)
# OpenRouter: https://openrouter.ai/api/v1 | DeepSeek: https://api.deepseek.com/v1
# AI_BASE_URL=https://api.openai.com/v1

# Провайдер-специфичные ключи (используются, если AI_API_KEY не задан)
GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Embeddings (семантический поиск, pgvector 768) ─────────────────────────
# auto (default) — gemini если есть ключ, иначе openai | gemini | openai | none
# Anthropic эмбеддинги не предоставляет — при AI_PROVIDER=anthropic задайте
# GEMINI_API_KEY или OPENAI_API_KEY, иначе семантический поиск отключится.
# EMBEDDING_PROVIDER=auto
# EMBEDDING_MODEL=text-embedding-004   # gemini default; openai: text-embedding-3-small

# ─── Квоты AI (тарифы Free/Pro) ──────────────────────────────────────────────
# Дневной лимит интерактивных AI-действий на пользователя (сброс в полночь UTC).
# Фоновые джобы импорта и эмбеддинги не считаются.
# QUOTA_FREE_AI_PER_DAY=20
# QUOTA_PRO_AI_PER_DAY=300

# ─── Биллинг (ЮKassa) ────────────────────────────────────────────────────────
# Кабинет ЮKassa → Интеграция → Ключи API. Для теста используй тестовый магазин
# (секретный ключ начинается с test_). Вебхук в кабинете: POST /api/billing/webhook,
# событие payment.succeeded (и payment.canceled).
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET_KEY=test_...
# PRO_PRICE_RUB=599
# URL фронтенда для возврата после оплаты (fallback — первый из ALLOWED_ORIGINS)
# FRONTEND_URL=https://your-frontend-domain.com
# Чеки 54-ФЗ (требует подключённой онлайн-кассы в ЮKassa)
# YOOKASSA_RECEIPT_EMAIL_REQUIRED=true

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes)
# Defaults to http://localhost:5173 if not set
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Error tracking (optional) ───────────────────────────────────────────────
# Install @sentry/node and set this to enable Sentry error reporting
# SENTRY_DSN=https://xxx@sentry.io/yyy
